#!/usr/bin/env bash
set -euo pipefail
umask 077

JAIL_DIR=$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")
source "$JAIL_DIR/lib/jail-common.sh"

usage() {
    cat <<'USAGE'
Usage: guix-terminal-jail [--paths | --init] [-h] [-m inject_keys_path] [-p pnpm_host_path] [project_dir]

Open an interactive Bash shell at /workspace.
project_dir defaults to the current working directory.
--paths shows project paths without starting a jail.
--init creates private project credentials if missing, then shows paths.
-m selects a host mitmproxy addon (default: bundled inject_keys.py).
-p selects a host pnpm directory (default: ~/.local/share/pnpm).
USAGE
}

while getopts "hm:p:-:" opt; do
    case "$opt" in
        -)
            case "$OPTARG" in
                paths|init) [[ $ACTION == run ]] || die "Choose one project action."; ACTION=$OPTARG ;;
                help) usage; exit 0 ;;
                *) die "Unknown option: --$OPTARG" ;;
            esac ;;
        h) usage; exit 0 ;;
        m) MITM_SCRIPT=$OPTARG ;;
        p) PNPM_HOST_PATH=$OPTARG ;;
        *) usage >&2; exit 1 ;;
    esac
done
shift $((OPTIND - 1))
(( $# <= 1 )) || die "Expected at most one project directory."
handle_workspace_action "${1:-$PWD}"
init_workspace
start_workspace
build_guix_args
run_container bash -c 'source "$HOME/.guix-jail-env" && cd /workspace && exec bash'
